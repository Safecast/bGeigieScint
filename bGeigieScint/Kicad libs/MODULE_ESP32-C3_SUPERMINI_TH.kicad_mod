(footprint "MODULE_ESP32-C3_SUPERMINI_TH" (layer "F.Cu") (tedit 6934D57F)
  (descr "ESP32-C3 Super Mini module footprint with through-hole pins for PomeloCore project")
  (tags "ESP32 ESP32-C3 SuperMini module WiFi BLE")
  (attr through_hole)
  
  ;; Reference and Value text
  (fp_text reference "REF**" (at 0 -14.5 0) (layer "F.SilkS")
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "ESP32-C3_SUPERMINI" (at 0 14.0 0) (layer "F.Fab")
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  
  ;; === LEFT SIDE PINS (GPIO pins, top to bottom) ===
  ;; Pin 0 - GPIO0/AFE_EN (topmost on left)
  (pad "0" thru_hole circle (at -7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 1 - GPIO1/PEAK_DIS
  (pad "1" thru_hole circle (at -7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 2 - GPIO2/RESET_CAP
  (pad "2" thru_hole circle (at -7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 3 - GPIO3/HV_PWM
  (pad "3" thru_hole circle (at -7.62 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 4 - GPIO4/PEAK_ADC
  (pad "4" thru_hole circle (at -7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 5 - GPIO5/SYNC_OUT
  (pad "5" thru_hole circle (at -7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 6 - GPIO6/TRIGGER
  (pad "6" thru_hole circle (at -7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  
  ;; === RIGHT SIDE PINS (Power and more GPIOs, top to bottom) ===
  ;; 5V Power
  (pad "5V" thru_hole circle (at 7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; 3.3V Power
  (pad "3.3" thru_hole circle (at 7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 7 - GPIO7/SYNC_IN
  (pad "7" thru_hole circle (at 7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 8 - GPIO8/I2C_SDA
  (pad "8" thru_hole circle (at 7.62 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 9 - GPIO9/I2C_SCL
  (pad "9" thru_hole circle (at 7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 10 - GPIO10/HV_CROWBAR
  (pad "10" thru_hole circle (at 7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 20 - GPIO20/UART_RX
  (pad "20" thru_hole circle (at 7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; Pin 21 - GPIO21/UART_TX
  (pad "21" thru_hole circle (at 7.62 10.16) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  ;; GND
  (pad "G" thru_hole circle (at -7.62 10.16) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
    (solder_mask_margin 0.102)
  )
  
  ;; === Module Outline (F.Fab) ===
  (fp_line (start -9.0 -11.5) (end 9.0 -11.5) (layer "F.Fab") (width 0.127))
  (fp_line (start 9.0 -11.5) (end 9.0 12.7) (layer "F.Fab") (width 0.127))
  (fp_line (start 9.0 12.7) (end -9.0 12.7) (layer "F.Fab") (width 0.127))
  (fp_line (start -9.0 12.7) (end -9.0 -11.5) (layer "F.Fab") (width 0.127))
  
  ;; USB-C Connector outline (top of module)
  (fp_line (start -4.5 -11.5) (end -4.5 -13.5) (layer "F.Fab") (width 0.127))
  (fp_line (start -4.5 -13.5) (end 4.5 -13.5) (layer "F.Fab") (width 0.127))
  (fp_line (start 4.5 -13.5) (end 4.5 -11.5) (layer "F.Fab") (width 0.127))
  
  ;; === Silkscreen Outline ===
  (fp_line (start -9.2 -11.7) (end 9.2 -11.7) (layer "F.SilkS") (width 0.127))
  (fp_line (start 9.2 -11.7) (end 9.2 12.9) (layer "F.SilkS") (width 0.127))
  (fp_line (start 9.2 12.9) (end -9.2 12.9) (layer "F.SilkS") (width 0.127))
  (fp_line (start -9.2 12.9) (end -9.2 -11.7) (layer "F.SilkS") (width 0.127))
  
  ;; Pin 1 indicator
  (fp_circle (center -7.62 -9.5) (end -7.12 -9.5) (layer "F.SilkS") (width 0.2) (fill none))
  
  ;; === Courtyard ===
  (fp_line (start -10.0 -14.0) (end 10.0 -14.0) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 10.0 -14.0) (end 10.0 13.5) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 10.0 13.5) (end -10.0 13.5) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -10.0 13.5) (end -10.0 -14.0) (layer "F.CrtYd") (width 0.05))
  
  ;; === 3D Model (optional) ===
  ;; (model "${KICAD7_3DMODEL_DIR}/Modules/ESP32-C3_SuperMini.wrl"
  ;;   (offset (xyz 0 0 0))
  ;;   (scale (xyz 1 1 1))
  ;;   (rotate (xyz 0 0 0))
  ;; )
)